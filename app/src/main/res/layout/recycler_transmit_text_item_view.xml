<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/transmit_message_text_card_view"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="3dp"
        android:layout_marginBottom="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/transmit_message_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="5dp"
                android:maxWidth="275dp"
                android:textIsSelectable="false" />


            <TextView
                android:id="@+id/transmit_message_text_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="5dp"
                android:maxWidth="275dp"
                android:text=""
                android:textColor="@color/text_gray"
                android:textIsSelectable="false"
                android:textSize="11sp"
                android:drawablePadding="6dp"
                app:drawableEndCompat="@drawable/baseline_back_hand_10"
                app:drawableTint="@color/text_gray" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>